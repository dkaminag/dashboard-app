{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://san.local/schemas/san-legal-agent-staging-evidence-v1.schema.json",
  "title": "SAN Legal Agent Staging Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "data_mode",
    "invocation_ref",
    "invocation_digest",
    "operator_ref",
    "operator_authenticated",
    "authorization_ref",
    "authorization_mapping_digest",
    "matter_ref_digest",
    "source_refs_digest",
    "source_count",
    "resolver_trust",
    "feature_flag_key",
    "feature_flag_enabled",
    "audit_event_ref",
    "audit_event_digest",
    "external_research_mode",
    "privileged_payload_externalized",
    "persistence_mode",
    "side_effects_enabled",
    "filing_enabled",
    "pjecalc_export_enabled",
    "retry_mode",
    "rollback_ref",
    "synthetic_e2e_passed",
    "attorney_review_required",
    "real_matter_authority",
    "production_authority"
  ],
  "properties": {
    "schema_version": {"const": "san-legal-agent-staging-evidence/v1"},
    "environment": {"const": "STAGING"},
    "data_mode": {"enum": ["SYNTHETIC", "DEIDENTIFIED"]},
    "invocation_ref": {"$ref": "#/$defs/ref"},
    "invocation_digest": {"$ref": "#/$defs/digest"},
    "operator_ref": {"$ref": "#/$defs/ref"},
    "operator_authenticated": {"const": true},
    "authorization_ref": {"$ref": "#/$defs/ref"},
    "authorization_mapping_digest": {"$ref": "#/$defs/digest"},
    "matter_ref_digest": {"$ref": "#/$defs/digest"},
    "source_refs_digest": {"$ref": "#/$defs/digest"},
    "source_count": {"type": "integer", "minimum": 1, "maximum": 200},
    "resolver_trust": {"const": "LOCAL_TRUSTED"},
    "feature_flag_key": {"const": "central.legal_agent.staging"},
    "feature_flag_enabled": {"const": true},
    "audit_event_ref": {"$ref": "#/$defs/ref"},
    "audit_event_digest": {"$ref": "#/$defs/digest"},
    "external_research_mode": {"enum": ["DISABLED", "PUBLIC_DERIVED_ONLY"]},
    "privileged_payload_externalized": {"const": false},
    "persistence_mode": {"enum": ["NONE", "DERIVED_ONLY"]},
    "side_effects_enabled": {"const": false},
    "filing_enabled": {"const": false},
    "pjecalc_export_enabled": {"const": false},
    "retry_mode": {"const": "IDEMPOTENT_READ_ONLY"},
    "rollback_ref": {"$ref": "#/$defs/ref"},
    "synthetic_e2e_passed": {"const": true},
    "attorney_review_required": {"const": true},
    "real_matter_authority": {"const": false},
    "production_authority": {"const": false}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@/+\\-]{0,499}$",
      "allOf": [
        {"not": {"pattern": "://"}},
        {"not": {"pattern": "(^|/)\\.{1,2}(/|$)"}}
      ]
    }
  }
}
